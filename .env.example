# demo never sends requests to Meta. live uses a separate database.
THREADS_MODE=demo
HOST=127.0.0.1
PORT=18473
# Set true behind HTTPS in live mode.
COOKIE_SECURE=false
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://your-domain.example/threads/callback
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional. Otherwise persistent keys are generated in instance/keys.json.
FLASK_SECRET_KEY=
TOKEN_ENCRYPTION_KEY=

